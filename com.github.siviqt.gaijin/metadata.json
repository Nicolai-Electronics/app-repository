          "target_file": "README.md"
        },
        {
          "source_file": "LICENSE",
          "target_file": "LICENSE"
        },
        {
          "source_file": "boot/manifest.bin",
          "target_file": "boot/manifest.bin"
        },
        {
          "source_file": "boot/Image",
          "target_file": "boot/Image"
        },
        {
          "source_file": "boot/tanmatsu.dtb",
          "target_file": "boot/tanmatsu.dtb"
        },
        {
          "source_file": "boot/initramfs",
          "target_file": "boot/initramfs"
        },
        {
          "source_file": "boot/rootfs.sqfs",
          "target_file": "boot/rootfs.sqfs"
        },
        {
          "source_file": "boot/rootfs.sqfs.sha256",
          "target_file": "boot/rootfs.sqfs.sha256"
        },
        {
          "source_file": "boot/userspace-abi.json",
          "target_file": "boot/userspace-abi.json"
        },
        {
          "source_file": "THIRD_PARTY.md",
          "target_file": "THIRD_PARTY.md"
        },
        {
          "source_file": "icon16.png",
          "target_file": "icon16.png"
        },
        {
          "source_file": "icon32.png",
          "target_file": "icon32.png"
        },
        {
          "source_file": "icon64.png",
          "target_file": "icon64.png"
        }
      ]
    }
  ]
}
