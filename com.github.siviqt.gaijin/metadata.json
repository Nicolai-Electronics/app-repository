{
  "name": "Gaijin",
  "description": "Native Linux with local and USB consoles and persistent SD state for Tanmatsu rev7.",
  "repository_url": "https://github.com/siviqt/Gaijin",
  "version": "0.5.19",
  "author": "Gaijin contributors",
  "categories": [
    "system"
  ],
  "license_type": "MIT",
  "license_file": "LICENSE",
  "icon": {
    "16x16": "icon16.png",
    "32x32": "icon32.png",
    "64x64": "icon64.png"
  },
  "application": [
    {
      "targets": [
        "tanmatsu"
      ],
      "type": "appfs",
      "executable": "linux-loader.bin",
